void cmd_set_position(MyCommandParser::Argument *args, char *response){
  int motorNumber = (int)args[0].asUInt64;
  int position = (int)args[1].asDouble;

  stepper_controller.setVelocityMode(motorNumber);//Before resetting switch to velocity mode to stop motors to respond to position values
  stepper_controller.setTargetVelocity(motorNumber, 0); //the parameter V_MAX should be set to zero...???
  delay(100);
  stepper_controller.setActualPosition(motorNumber, position); //set the actual position value
  stepper_controller.setTargetPosition(motorNumber, position); //Target has to be set to ta same so it does not start to go away
  stepper_controller.setRampMode(motorNumber);
  delay(10);

  int newpos = stepper_controller.getActualPosition(motorNumber);
  
  snprintf(response, MyCommandParser::MAX_RESPONSE_SIZE, "PO %d %d", motorNumber, newpos);
  // Serial.print("PO"); Serial.println(stepper_controller.getActualPosition(motorNumber));
}

void serialListener() {
  if (Serial.available()) {
    char line[128];
    size_t lineLength = Serial.readBytesUntil('\n', line, 127);
    line[lineLength] = '\0';

    char response[MyCommandParser::MAX_RESPONSE_SIZE];
    parser.processCommand(line, response);
    Serial.println(response);
  }
}

