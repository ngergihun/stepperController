const long SERIAL_BAUD_RATE = 115200; //Baud rate of the UART
//----
const int RX_PIN = 0; //Physical pins of the serial port
const int TX_PIN = 1;

const int RUN_CURRENT_PERCENT = 80; //Percentage current
const int HOLD_CURRENT_PERCENT = 10;
const int MICROSTEPS_PER_STEP = 8; //Microstepping (16 is more than enough)
const int CHIP_SELECT_PIN = 10; //Chip select pin ??? Is it for the TMC429 ???
const int CLOCK_FREQUENCY_MHZ = 32; //32 MHz - external source, generated by the Teensy on pin 9. See later in the code.
const int STEPS_PER_REV = 400; //Depends on the stepper motor, but typically either 200 (1.8 deg/step) or 400 (0.9 deg/step)
const int MICROSTEPS_PER_REV = STEPS_PER_REV * MICROSTEPS_PER_STEP; //Total steps needed to complete a full turn
const long ZERO_POSITION = 0; //Shortcut for the zero position
const long VELOCITY_MAX = 0.5 * MICROSTEPS_PER_REV; //Similarly to the acceleration, this is also empirical!
const int ACCELERATION_MAX = VELOCITY_MAX * 4; //Needs to be tested empirically because the mechanism (friction) can affect it
const long VELOCITY_MIN = 50; //Velocity cannot be 0, see datasheet. Below 50 steps/s the motor shuts down.

// New variables instead of the contants to dynamically change them if needed
long maxspeed_list[3] = {VELOCITY_MAX, VELOCITY_MAX, VELOCITY_MAX};
long maxaccel_list[3] = {ACCELERATION_MAX, ACCELERATION_MAX, ACCELERATION_MAX};

int microsteps_list[3] = {MICROSTEPS_PER_STEP, MICROSTEPS_PER_STEP, MICROSTEPS_PER_STEP};
int motorsteps_list[3] = {STEPS_PER_REV, STEPS_PER_REV, STEPS_PER_REV};

//Pins
const byte Analog_X_pin = A2; //x-axis readings - A2: 16
const byte Analog_Y_pin = A1; //y-axis readings - A1: 15
