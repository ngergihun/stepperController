void setup()
{
  delay(1000);
  //SERIAL - USB
  Serial.begin(9600);
  Serial.println("TMC249 - TMC2209 - 3-axis motor driver board");
  //Serial COMANNDs setup
  // Movements and positions
  parser.registerCommand("gp", "u", &cmd_get_position); // Get Position
  parser.registerCommand("sp","ud", &cmd_set_position); // Sets the current position value to the defined number (useful for example resetting position)
  parser.registerCommand("mr", "ud", &cmd_go_relative); // Relative move in STEPs
  parser.registerCommand("ma", "ud", &cmd_go_absolute); // Absolute move in STEPs
  // ----- 2D MOVEMENTS ARE IMPLEMENTED FROM APPLICATION SOFTWARE ---------------------
  // parser.registerCommand("2r", "uudd", &cmd_move2d_relative); // Move in 2d - move in plane
  // parser.registerCommand("2a", "uudd", &cmd_move2d_absolute); // Move in 2d - move in plane

  // Switches
  parser.registerCommand("ea", "u", &cmd_enable_advanced_switchstop); // Enable the advanced switch monitoring
  parser.registerCommand("es", "u", &cmd_enable_switches); // Enable switches
  parser.registerCommand("ss", "uu", &cmd_enable_switches_per_motor); // Enable switches per motor
  parser.registerCommand("gs", "u", &cmd_get_switch_state); // Get the switch states per motor

  // Microsteps, move mode
  parser.registerCommand("sm", "uu", &cmd_set_microsteps); // Set microsteps for the given motor driver
  parser.registerCommand("mm", "uu", &cmd_set_move_mode); // Change move mode
  // parser.registerCommand("gm", "u", &cmd_get_microsteps); // Get the current microstep settings for the given motor

  // Velocities
  // Setters
  parser.registerCommand("sv","uu", &cmd_set_maxvelocity); // Sets the maximum velocity microsteps/revolution
  parser.registerCommand("tv","dd", &cmd_set_targetvelocity); // Sets the targetvelocity for velocitymode
  parser.registerCommand("sa","uu", &cmd_set_maxacceleration); // Sets the maximum accelaration that the rampgenerator will use to calculate velocity profile
  // Getters
  // parser.registerCommand("gv","u", &cmd_get_maxvelocity); // Get the maximum velocity microsteps/revolution
  // parser.registerCommand("ga","u", &cmd_get_maxacceleration); // Gets the maximum accelaration that the rampgenerator will use to calculate velocity profile
  // parser.registerCommand("gt","u", &cmd_get_targetvelocity); // Gets the targetvelocity for velocitymode
  parser.registerCommand("gv", "u", &cmd_get_velocities); // This returns all the velocities

  // Homing, movements check
  // parser.registerCommand("ho","u", &cmd_home_axis); // Homing for the given motor
  parser.registerCommand("mo","u", &cmd_is_moving); // Cheks if the given motor is moving base on velocity or targetposition

  // Auto tuning
  parser.registerCommand("at","u", &cmd_autotune); // Cheks if the given motor is moving base on velocity or targetposition

  //SERIAL for TMC2209
  Serial1.begin(SERIAL_BAUD_RATE);

  //Start the 32 MHz signal for the TMC429 (don't forget to compile the code with CPU = 528 MHz!)
  analogWriteFrequency(clkPin, CLOCK_FREQUENCY_MHZ*1000000); //Set pin and frequency
  analogWrite(clkPin, 128); //Start signal, 50% duty cycle

  //----------------------------------------------------------------------------
  Wire.begin(); 
  Wire.beginTransmission(0x20);
  Wire.write(0xFF);  //All ON - This is needed to be used with pull-up resistors
  Wire.endTransmission();
  //----------------------------------------------------------------------------
  //PINS
  pinMode(forwardButton, INPUT);
  pinMode(backwardButton, INPUT);
  pinMode(abortButton, INPUT);
  pinMode(redLEDpin, OUTPUT);
  pinMode(greenLEDpin, OUTPUT);
  pinMode(blueLEDpin, OUTPUT);
  //No lights
  analogWrite(redLEDpin, 0);
  analogWrite(greenLEDpin, 0);
  analogWrite(blueLEDpin, 0);
  //----------------------------------------------------------------------------
  InitialValues(); //averaging the values of the 3 analog pins (values from potmeters)
  //----------------------------------------------------------------------------

  //Motor drivers and main controller
  driver_list[0].setup(Serial1, SERIAL_BAUD_RATE, SERIAL_ADDRESS_0);
  driver_list[1].setup(Serial1, SERIAL_BAUD_RATE, SERIAL_ADDRESS_1);
  driver_list[2].setup(Serial1, SERIAL_BAUD_RATE, SERIAL_ADDRESS_2);
  stepper_controller.setup(CHIP_SELECT_PIN, CLOCK_FREQUENCY_MHZ);

  // Limit switch setup
  stepper_controller.setSwitchesActiveHigh(); //When switch goes HIGH, it sets an active reference switch signal.
  stepper_controller.enableRightSwitches();

  //DRIVER SETUP ------------------------------------------------------------
  //Stepper parameters
  //setting up some default values for maximum speed and maximum acceleration
  for (int i = 0; i < 3; i++) 
  {
    // Driver setup
    setupDriver(i, RUN_CURRENT_PERCENT, microsteps_list[i]);
    // Limit switch setup
    if (limitSwitchesEnabled == true)
    {
      enableSwitchesPerMotor(i, limitSwitchesEnabled);
      stepper_controller.setReferenceSwitchToLeft(i); //Homing switch is at the left (negative, motor) side
    }
    // Controller setup
    stepper_controller.setLimitsInHz(i, VELOCITY_MIN, VELOCITY_MAX, ACCELERATION_MAX);
    stepper_controller.setVelocityMode(i);//Before overwriting X_ACTUAL choose velocity_mode or hold_mode.
    stepper_controller.setTargetVelocity(i, 0); //...the parameter V_MAX should be set to zero...
    stepper_controller.setActualPosition(i, ZERO_POSITION);
    stepper_controller.setTargetPosition(i, ZERO_POSITION);
    stepper_controller.setRampMode(i); // Ramp with linear stop
    driver_list[i].enable();
    driver_list[i].moveUsingStepDirInterface();
    delay(250);

  }

  enableAllSwitches(limitSwitchesEnabled);

  int testmotor = 0;
  Serial.print("PWM Scale Auto, Offset Auto, Gradient Auto = ");
  Serial.print(driver_list[testmotor].getPwmScaleAuto()); Serial.print(" "); Serial.print(driver_list[testmotor].getPwmOffsetAuto()); Serial.print(" "); Serial.println(driver_list[testmotor].getPwmGradientAuto());


}

void loop()
{
  // serialCommandReceiver(); //Polls the serial port for incoming instructions/commands
  serialListener();
  ReadAnalog(); //Read the joystick
  checkButtons(); //Poll the buttons
  driveMotorWithButtons(); //Send commands to the motor when it is actual
  readGPIOExpander(); //Read which axis and which control mode is enabled
  sendNewSettings(); //When the user switches to another mode, this function takes care of it. 
  monitorLimitSwitches(); //Keeps monitoring the switches and parks the motors after a limit switch was hit while moving
  checkMotorMovement(); //Check if the motor is moving so we can keep the LEDs properly updated
  //----------------------------------------------------------------------------------------------------------------------
  //This function runs last so everything has the chance to update the statuses
  updateStatusLED();
}

void setupDriver(int motorNumber, int current_percent, int microsteps)
{
  driver_list[motorNumber].setRunCurrent(current_percent);
  driver_list[motorNumber].setHoldCurrent(HOLD_CURRENT_PERCENT);
  driver_list[motorNumber].setHoldDelay(10);
  // driver_list[motorNumber].useInternalSenseResistors();
  driver_list[motorNumber].enableAutomaticCurrentScaling();
  driver_list[motorNumber].enableAutomaticGradientAdaptation();
  driver_list[motorNumber].enableCoolStep();
  driver_list[motorNumber].setMicrostepsPerStep(microsteps);
  driver_list[motorNumber].enableStealthChop(); //This MUST be enabled for correct motor behaviour
}

void AutoTuneDriver(int motorNumber)
{
  TMC2209::Settings settings = driver_list[motorNumber].getSettings();
  if(settings.software_enabled == 0){driver_list[motorNumber].enable();};

  // Serial.print("PWM Scale Auto, Offset Auto, Gradient Auto = ");
  // Serial.print(driver_list[motorNumber].getPwmScaleAuto()); Serial.print(" "); Serial.print(driver_list[motorNumber].getPwmOffsetAuto()); Serial.print(" "); Serial.println(driver_list[motorNumber].getPwmGradientAuto());

  // driver_list[motorNumber].enableAutomaticCurrentScaling();
  // Move a bit to switch to I_RUN
  goRelative(motorNumber, microsteps_list[motorNumber]);
  while (stepper_controller.getActualVelocity(motorNumber) != 0 || stepper_controller.atTargetPosition(motorNumber) == false){
      delay(10);
  }
  // Wait 300 ms
  delay(300);

  // Serial.print("PWM Scale Auto, Offset Auto, Gradient Auto = ");
  // Serial.print(driver_list[motorNumber].getPwmScaleAuto()); Serial.print(" "); Serial.print(driver_list[motorNumber].getPwmOffsetAuto()); Serial.print(" "); Serial.println(driver_list[motorNumber].getPwmGradientAuto());
  
  // Move a full spin and back
  int oldaccel = stepper_controller.getAccelerationMaxInHzPerS(motorNumber);
  int oldspeed = stepper_controller.getVelocityMaxInHz(motorNumber);
  int newspeed = 1*MICROSTEPS_PER_REV;
  int newaccel = 3*newspeed;
  // Set a bit higher speed
  changeMaxVelocities(motorNumber, newspeed, newaccel);
  int steps = microsteps_list[motorNumber]*motorsteps_list[motorNumber];
  goRelative(motorNumber,2*steps);
  while (stepper_controller.getActualVelocity(motorNumber) != 0 || stepper_controller.atTargetPosition(motorNumber) == false){
      delay(100);
  }
  // Serial.print("PWM Scale Auto, Offset Auto, Gradient Auto = ");
  // Serial.print(driver_list[motorNumber].getPwmScaleAuto()); Serial.print(" "); Serial.print(driver_list[motorNumber].getPwmOffsetAuto()); Serial.print(" "); Serial.println(driver_list[motorNumber].getPwmGradientAuto());
  
  delay(250);

  // Go back to the origin
  goRelative(motorNumber,-2*steps);
  while (stepper_controller.getActualVelocity(motorNumber) != 0 || stepper_controller.atTargetPosition(motorNumber) == false){
      delay(100);
  }

  driver_list[motorNumber].setHoldCurrent(0);

  changeMaxVelocities(motorNumber, oldspeed, oldaccel);
}

void changeMicroSteps(int motorNumber, int microsteps)
{
  int old_microsteps = driver_list[motorNumber].getMicrostepsPerStep();
  // Set up the new settings
  driver_list[motorNumber].setMicrostepsPerStep(microsteps);
  microsteps_list[motorNumber] = driver_list[motorNumber].getMicrostepsPerStep();
  // Update the acceleration values
  maxaccel_list[motorNumber] = maxaccel_list[motorNumber]/old_microsteps*microsteps_list[motorNumber];
  maxspeed_list[motorNumber] = maxspeed_list[motorNumber]/old_microsteps*microsteps_list[motorNumber];
  stepper_controller.setLimitsInHz(motorNumber, VELOCITY_MIN, maxspeed_list[motorNumber], maxaccel_list[motorNumber]);
}

void changeMaxVelocities(int motorNumber, int maxspeed, int maxaccel)
{
  maxspeed_list[motorNumber] = maxspeed;
  maxaccel_list[motorNumber] = maxaccel;
  stepper_controller.setLimitsInHz(motorNumber, VELOCITY_MIN, maxspeed, maxaccel);
}

void checkMotorMovement() // for the LEDs
{
    for (int i = 0; i < 3; i++)
    {
        //Check each stepper motor if they are moving or not.
        if (stepper_controller.getActualVelocity(i) != 0)
        {
          stepperIsMoving = true;
          //If at least one motor is moving, we can immediately jump out of this loop
          break;
        } 
        else
        {
            stepperIsMoving = false;
        }
    }
}

bool isMotorMoving(int motorNumber)
{
  bool moving;
  if (stepper_controller.getActualVelocity(motorNumber) != 0)
  {
    moving = true;
  } 
  else
  {
    moving = false;
  }
  return moving;
}

void updateStatusLED()
{
    //This function follows the status flags and triggers the correspoding LED
    //Abort button is pressed - Blinking Red
    if (abortMovement == true)
    {
        //Serial.println("Red LED, blinking");
        if (millis() - redLEDTimer >= 1000) //Blink Red LED every 1 s
        {
            if (redLEDStatus == false)
            {
                analogWrite(redLEDpin, 255);
                analogWrite(greenLEDpin, 0);
                analogWrite(blueLEDpin, 0);
                redLEDStatus = true;
            }
            else
            {
                analogWrite(redLEDpin, 0); //(no need to update all three because the previous if() did it)
                redLEDStatus = false;
            }
            redLEDTimer = millis();
        }
    }
    
    else if (stepper_controller.communicating() == false)
    {       
        analogWrite(redLEDpin, 255);
        analogWrite(greenLEDpin, 165);
        analogWrite(blueLEDpin, 0);
    }    
    else if(limitSwitchActive == true) //Turn on red LED when any of the limit switches are active
    {
        analogWrite(redLEDpin, 255);
        analogWrite(greenLEDpin, 0);
        analogWrite(blueLEDpin, 0);
    }
    else if (stepperIsMoving == true) //Turn on green LED when any of the motors are moving
    {
        analogWrite(redLEDpin, 0);
        analogWrite(greenLEDpin, 255);
        analogWrite(blueLEDpin, 0);
    }
    else //Standby - Turn on blue LED
    {
        analogWrite(redLEDpin, 0);
        analogWrite(greenLEDpin, 0);  
        analogWrite(blueLEDpin, 255);
    }
}

void readGPIOExpander()
{
    //This function reads the GPIO expander
    //0-1-2 pins: X-Y-Z selector - Always only 1 axis is active
    //3-4-5 pins: Joystick, button, UART selector - Always only 1 mode is active
    byte gpioData = 0; //8-bit reading from the expander
    Wire.requestFrom(0x20, 1); //get 1 byte (8bit) from 0x20 address
    if (Wire.available()) 
    {
        gpioData = Wire.read();
    }
    /*
    //This little code prints back the bits that were set for the GPIO module
    Serial.print("GPIO: ");
    for (int i = 7; i >= 0; i--)
    {
        Serial.print((gpioData >> i) & 1); 
        //Print/shift the register bits until the whole byte is printed
    }
    Serial.println();    
    //------------------------------------------------------------------------------
    */

    if (previousGPIOData != gpioData)
    {
        previousGPIOData = gpioData; //Update to the most recent reading
        updateSettings = true; //Let the rest of the code know about the new values
        limitSwitchActive = false; //Reset limit switch status here
        if (debugMode == true){Serial.println("Updated switch statuses!");}

        //Blink the blue LED to indicate the received change
        analogWrite(redLEDpin, 0);
        analogWrite(blueLEDpin, 0);
        analogWrite(greenLEDpin, 0);

        for (int i = 0; i < 3; i++)
        {
            analogWrite(blueLEDpin, 0);
            delay(50);
            analogWrite(blueLEDpin, 255);
            delay(50);
        } //(100+100)*5 ms = 1000 ms delay
    }

    //Ugly implementation of reading the individual bits

    if (bitRead(gpioData, 0) == 1) //If pin 0 is high
    {
        buttonModeXAxis = false;
    }
    else //Pin 0 is low -> pulled to GND via the switch, so it is ACTIVE!
    {
        buttonModeXAxis = true;
    }

    if (bitRead(gpioData, 1) == 1) //If pin 1 is high
    {
        buttonModeYAxis = false;
    }
    else
    {
        buttonModeYAxis = true;
    }

    if (bitRead(gpioData, 2) == 1) //If pin 2 is high
    {
        buttonModeZAxis = false;
    }
    else
    {
        buttonModeZAxis = true;
    }
    //----------------------------------------------------------------
    if (bitRead(gpioData, 3) == 1) //If pin 3 is high
    {        
        joystickMode = false;
    }
    else
    {
        joystickMode = true;
    }

    if (bitRead(gpioData, 4) == 1) //If pin 4 is high
    {
        buttonMode = false;
    }
    else
    {
        buttonMode = true;
    }

    if (bitRead(gpioData, 5) == 1) //If pin 5 is high
    {
        UARTMode = false;
    }
    else
    {
        UARTMode = true;
    }
    //--------------------------------------------------------------------
}

void ReadAnalog()
{
    if (joystickMode == true) //Only listen to the joystick when the joystick mode is enabled!
    {
        //Reading the 3 potentiometers in the joystick: x, y and r.

        for (int i = 0; i < 10; i++) //Sum 10 readings
        {
            Analog_X += analogRead(Analog_X_pin);
            delayMicroseconds(10);
            Analog_Y += analogRead(Analog_Y_pin);
            delayMicroseconds(10);
            Analog_Z += analogRead(Analog_Z_pin);
            delayMicroseconds(10);
        } //300 us delay + 30x ADC conversion time which is just a few us total

        //Divide the sum of 10 readings by 10
        Analog_X /= 10.0;
        Analog_Y /= 10.0;
        Analog_Z /= 10.0;
                

        //if the value is 20 units away from the average (midpoint), we allow the update of the speed
        //This is a sort of a filter for the inaccuracy of the reading
        if (abs(Analog_X - Analog_X_AVG) > 20)
        {
            joystickSpeedX = (int)(3.8 * (Analog_X - Analog_X_AVG));
            if (debugMode == true){
                Serial.print("joystick-X:"); Serial.println(joystickSpeedX);
                }
            //speed = x
            stepper_controller.setTargetVelocity(0, joystickSpeedX);      
            //The 12 multiplier depends on the mechanism used with the motor. Test it with your system!
            stepperIsMoving = true;                        
        }
        else if (abs(Analog_Y - Analog_Y_AVG) > 20)
        {
            joystickSpeedY = (int)(3.8 * (Analog_Y - Analog_Y_AVG));
            if (debugMode == true){
                Serial.print("joystick-Y:"); Serial.println(joystickSpeedY);
            }

            // speed = y
            stepper_controller.setTargetVelocity(1, joystickSpeedY);
            //The 12 multiplier depends on the mechanism used with the motor. Test it with your system!
            stepperIsMoving = true;
        }
        else if (abs(Analog_Z - Analog_Z_AVG) > 30) //Z works well with these settings
        {
            joystickSpeedZ = (int)(3.8 * (Analog_Z - Analog_Z_AVG));
            if (debugMode == true){
                Serial.print("joystick-Z:"); Serial.println(joystickSpeedZ);
            }

            //speed = z
            stepper_controller.setTargetVelocity(2, joystickSpeedZ);
            //The 5 multiplier depends on the mechanism used with the motor. Test it with your system!
           stepperIsMoving = true;
        }
        else
        {
            if (debugMode == true){
                Serial.println("joystick-standstill");
            }

            //speed = 0 for all motors
            stepper_controller.setTargetVelocity(0, 0); 
            stepper_controller.setTargetVelocity(1, 0);
            stepper_controller.setTargetVelocity(2, 0);
            stepperIsMoving = false;
        }      
        //Reset analog values - necessary, otherwise the sum will be messed up!
        Analog_X = 0;
        Analog_Y = 0;
        Analog_Z = 0;
    }
}

void InitialValues()
{
  //Set the temp values to zero before averaging
  float tempX = 0;
  float tempY = 0;
  float tempZ = 0;
  //----------------------------------------------------------------------------
  //read the analog 50x, then calculate an average.
  //they will be the reference values
  for (int i = 0; i < 50; i++)
  {
    tempX += analogRead(Analog_X_pin);
    delay(10); //allowing a little time between two readings
    tempY += analogRead(Analog_Y_pin);
    delay(10);
    tempZ += analogRead(Analog_Z_pin);
    delay(10);
  }
  //(30 ms + readout(?))*50 times approx 2 seconds
  //----------------------------------------------------------------------------
  Analog_X_AVG =(int)( tempX / 50.0);
  Analog_Y_AVG =(int)(tempY / 50.0);
  Analog_Z_AVG =(int)(tempZ / 50.0); //The float division is casted into int.
  //----------------------------------------------------------------------------
  if (debugMode == true){
    Serial.print("AVG_X: ");
    Serial.println(Analog_X_AVG);
    Serial.print("AVG_Y: ");
    Serial.println(Analog_Y_AVG);
    Serial.print("AVG_Z: ");
    Serial.println(Analog_Z_AVG);
    Serial.println("Calibration is finished!");
  }
}

void setMoveMode(int motornum, int modecode)
{
    switch (modecode){
    case 0:{
      int pos = stepper_controller.getActualPosition(motornum);
      stepper_controller.setTargetPosition(motornum, pos);
      stepper_controller.setSoftMode(motornum); // exponential acceleration at start and finish
      break;}
    case 1:{
      int pos = stepper_controller.getActualPosition(motornum);
      stepper_controller.setTargetPosition(motornum, pos);
      stepper_controller.setRampMode(motornum); // linear acceleration (speed change)
      break;}
    case 2:{
      stepper_controller.setVelocityMode(motornum); // constant target velocity is maintained
      break;}
    case 3:{
      stepper_controller.setHoldMode(motornum); // brutally goes wherever you want it - HULK MODE
      break;}
  }
}

// STEP UNIT MOVEMENTS ------------------------------------------------------------------------------------------------------------------------------------------------
// RELATIVE -------------------------------------------------------------------------
void goRelative(int motorNumber, long Steps) //Moves the stage by Steps STEP along the X axis relative to the current position
{
  long targetSteps = 0;
  //Get the current position of the X motor in STEPS
  long start_position = stepper_controller.getActualPosition(motorNumber);
  //Add relative movement steps to the current position to get the new target location
  targetSteps = start_position + Steps;
  //send the command to the TMC429
  stepper_controller.setTargetPosition(motorNumber, targetSteps);
}
// ABSOLUTE -------------------------------------------------------------------------
void goAbsolute(int motorNumber, long Steps) //Moves the stage by Steps STEP along the X axis relative to the current position
{
  stepper_controller.setTargetPosition(motorNumber, Steps); //Move X (0) to the recently determined target
}

void go2dRelative(int motorNumber1, int motorNumber2, long Position1, long Position2) //Brings the stage to a predetermined x and y simultaneously position in mm
{
    // long start_position1 = stepper_controller.getActualPosition(motorNumber1);
    // long start_position2 = stepper_controller.getActualPosition(motorNumber2);

    // Get the original velocity setting for the two axes
    long oldMotorSpeed1 = stepper_controller.getVelocityMaxInHz(motorNumber1);
    long oldMotorSpeed2 = stepper_controller.getVelocityMaxInHz(motorNumber2);
    long oldAccel1 = stepper_controller.getAccelerationMaxInHzPerS(motorNumber1);
    long oldAccel2 = stepper_controller.getAccelerationMaxInHzPerS(motorNumber2);

    // Calculate speeds for the different directions
    float angle = atan2f((float)Position2, (float)Position1);
    float v = (float)(oldMotorSpeed1+oldMotorSpeed2)/2;
    float a = (float)(oldAccel1+oldAccel2)/2;
    // Serial.print("Original avg speed:"); Serial.println((long)v);
    // Serial.print("Original avg accel:"); Serial.println((long)a);
    long speed1 = (long)abs(v*cosf(angle));
    long speed2 = (long)abs(v*sinf(angle));
    int accel1 = (int)abs(a*cosf(angle));
    int accel2 = (int)abs(a*sinf(angle));
    // Serial.print("New Speed 1:"); Serial.println(speed1);
    // Serial.print("New Speed 2:"); Serial.println(speed2);
    // Serial.print("New Accel 1:"); Serial.println(accel1);
    // Serial.print("New Accel 2:"); Serial.println(accel2);

    stepper_controller.setLimitsInHz(motorNumber1, VELOCITY_MIN, speed1, accel1);
    delayMicroseconds(50);
    stepper_controller.setLimitsInHz(motorNumber2, VELOCITY_MIN, speed2, accel2);
    delayMicroseconds(50);

    goRelative(motorNumber1, Position1);
    delayMicroseconds(10); //a short delay, but probably, it is unnecessary
    goRelative(motorNumber2, Position2);
    delayMicroseconds(10);

    while (stepper_controller.getActualVelocity(motorNumber1) != 0 || stepper_controller.getActualVelocity(motorNumber2) != 0 || stepper_controller.atTargetPosition(motorNumber1) == false || stepper_controller.atTargetPosition(motorNumber2) == false){
      delay(10);
      // Serial.println("Moving?");
    }
    // Apply the old speed settings again
    stepper_controller.setLimitsInHz(motorNumber1, VELOCITY_MIN, oldMotorSpeed1, oldAccel1);
    delayMicroseconds(50);
    stepper_controller.setLimitsInHz(motorNumber2, VELOCITY_MIN, oldMotorSpeed2, oldAccel2);
}

void go2dAbsolute(int motorNumber1, int motorNumber2, long Position1, long Position2) //Brings the stage to a predetermined x and y simultaneously position in mm
{   // Get the starting coordinates
    long start_position1 = stepper_controller.getActualPosition(motorNumber1);
    long start_position2 = stepper_controller.getActualPosition(motorNumber2);
    // Calculate the relative movements
    long delta1 = Position1 - start_position1;
    long delta2 = Position2 - start_position2;
    // Get the original velocity setting for the two axes
    long oldMotorSpeed1 = stepper_controller.getVelocityMaxInHz(motorNumber1);
    long oldMotorSpeed2 = stepper_controller.getVelocityMaxInHz(motorNumber2);
    long oldAccel1 = stepper_controller.getAccelerationMaxInHzPerS(motorNumber1);
    long oldAccel2 = stepper_controller.getAccelerationMaxInHzPerS(motorNumber2);
    // Calculate speeds for the different directions
    float angle = atan2f((float)delta2, (float)delta1);
    float v = (float)(oldMotorSpeed1+oldMotorSpeed2)/2;
    float a = (float)(oldAccel1+oldAccel2)/2;
    long speed1 = (long)abs(v*cosf(angle));
    long speed2 = (long)abs(v*sinf(angle));
    int accel1 = (int)abs(a*cosf(angle));
    int accel2 = (int)abs(a*sinf(angle));

    stepper_controller.setLimitsInHz(motorNumber1, VELOCITY_MIN, speed1, accel1);
    delayMicroseconds(50);
    stepper_controller.setLimitsInHz(motorNumber2, VELOCITY_MIN, speed2, accel2);
    delayMicroseconds(50);

    goAbsolute(motorNumber1, Position1);
    delayMicroseconds(10); //a brief delay, but probably, it is unnecessary
    goAbsolute(motorNumber2, Position2);
    delayMicroseconds(10);

    while (stepper_controller.getActualVelocity(motorNumber1) != 0 || stepper_controller.getActualVelocity(motorNumber2) != 0 || stepper_controller.atTargetPosition(motorNumber1) == false || stepper_controller.atTargetPosition(motorNumber2) == false){
      delay(10);
      // Serial.println("Moving?");
    }
    // Apply the old speed settings again
    stepper_controller.setLimitsInHz(motorNumber1, VELOCITY_MIN, oldMotorSpeed1, oldAccel1);
    delayMicroseconds(50);
    stepper_controller.setLimitsInHz(motorNumber2, VELOCITY_MIN, oldMotorSpeed2, oldAccel2);
}
