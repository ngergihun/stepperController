//Variables
int Analog_X = 0; //x-axis value
int Analog_Y = 0; //y-axis value
int Analog_Z = 0; //r-axis value

int Analog_X_AVG = 0; //x-axis value average
int Analog_Y_AVG = 0; //y-axis value average
int Analog_Z_AVG = 0; //r-axis value average

int joystickSpeedX = 0;
int joystickSpeedY = 0;
int joystickSpeedZ = 0;

float buttonSpeedinHz = 0.5;
int buttonSpeed = buttonSpeedinHz*MICROSTEPS_PER_STEP*STEPS_PER_REV;

