void serialCommandReceiver() //This function polls the serial port and received the commands sent from the computer
{
    if (UARTMode == true)
    {
        if (Serial.available() > 0)
        {
            char commandCharacter = Serial.read(); //we use characters (letters) for controlling the switch-case

            switch (commandCharacter) //based on the command character, we decide what to do
            {

            case 'a': //Acceleration (steps/s^2) - Not necessarily needed when RAMP mode is used 
            {
                receivedAcceleration = Serial.parseInt(); //Parse the value
                Serial.print("New acceleration: ");
                Serial.println(receivedAcceleration);
                //Usage: a2000 -> acceleration = 2000 steps/s^2
                
                //First we read the current speed settings because we don't want to override those
                long tempV_x = stepper_controller.getVelocityMaxInHz(0);
                long tempV_y = stepper_controller.getVelocityMaxInHz(1);
                long tempV_z = stepper_controller.getVelocityMaxInHz(2);

                //Apply new acceleration to all motors
                stepper_controller.setLimitsInHz(0, 0, tempV_x, receivedAcceleration);
                stepper_controller.setLimitsInHz(1, 0, tempV_y, receivedAcceleration);
                stepper_controller.setLimitsInHz(2, 0, tempV_z, receivedAcceleration);
            }
                break;

            case 'v': //Velocity (steps/s)
            {
                receivedVelocity = Serial.parseInt(); //Parse the value
                Serial.print("New Velocity: ");
                Serial.println(receivedVelocity);
                //Usage: v200 -> velocity = 200 steps/s
                
                //First we read the current speed settings because we don't want to override those
                long tempA_x = stepper_controller.getAccelerationMaxInHzPerS(0);
                long tempA_y = stepper_controller.getAccelerationMaxInHzPerS(1);
                long tempA_z = stepper_controller.getAccelerationMaxInHzPerS(2);

                //Apply to all motors
                stepper_controller.setLimitsInHz(0, 0, receivedVelocity, tempA_x);
                stepper_controller.setLimitsInHz(1, 0, receivedVelocity, tempA_y);
                stepper_controller.setLimitsInHz(2, 0, receivedVelocity, tempA_z);
            }
                break;

            //Notice! These are ABSOLUTE positions ("move to")
            case 'x': //go to X
            {
                float tempX; //temporary X value
                tempX = Serial.parseFloat(); //Parse the value
                Serial.print("X target: ");
                Serial.println(tempX);
                goToX(tempX); //Pass the command to the controller
                //Usage: x4.2 -> goes to 4.2 mm position along the X axis
            }
                break;

            case 'y': //go to Y
            {
                float tempY; //temporary Y value
                tempY = Serial.parseFloat(); //Parse the value
                Serial.print("Y target: ");
                Serial.println(tempY);
                goToY(tempY); //Pass the command to the controller
                //Usage: x2.7 -> goes to 2.7 mm position along the Y axis
            }
                break;

            case 'z': //go to Z
            {
                float tempZ; //temporary Z value
                tempZ = Serial.parseFloat(); //Parse the value
                Serial.print("Z target: ");
                Serial.println(tempZ);
                goToZ(tempZ); //Pass the command to the controller
                //Usage: x0.9 -> goes to 0.9 mm position along the Z axis
            }
                break;

            case 'p': //go to position (X-Y simultaneously)
            {
                float tempXp; //temporary X value
                float tempYp; //temporary Y value
                String twoFloats = Serial.readStringUntil('\n');; //String that contains the 2 floatin point numbers

                tempXp = twoFloats.substring(0, twoFloats.indexOf(',')).toFloat();; //Parse the X value
                tempYp = twoFloats.substring(twoFloats.indexOf(',') + 1).toFloat(); //Parse the Y value

                goToXY(tempXp, tempYp); //Pass the command to the controller 
                //Usage: p3.24,4.56 -> x goes to 3.24 mm, y goes to 4.56 mm   
                Serial.print("Parsed targets X: ");
                Serial.print(tempXp);
                Serial.print(", Y: ");
                Serial.println(tempYp);
            }
                break;

            case 'r': //go to relative position
            {
                float tempSteps; //number of steps
                float tempMotor; //motor number
                String twoFloats = Serial.readStringUntil('\n');; //String that contains the 2 floatin point numbers

                tempSteps = twoFloats.substring(0, twoFloats.indexOf(',')).toFloat(); //Parse the X value
                tempMotor = twoFloats.substring(twoFloats.indexOf(',') + 1).toFloat(); //Parse the Y value
                
                int steps_num = round(tempSteps);
                int motor_num = round(tempMotor);

                goRelative(steps_num, motor_num); //Pass the command to the controller 
                Serial.print("Parsed steps: ");
                Serial.print(steps_num);
                Serial.print(", Motor: ");
                Serial.println(motor_num);
            }
                break;

            case 'h': //Home a selected motor
            {
                int selectedMotor = 0; //0: x, 1: y, 2: z
                selectedMotor = Serial.parseInt(); //Example: "h0" selects motor 0.
                motorHoming(selectedMotor);
                //Usage: h0 -> homes the X-axis
                Serial.println("Homing initiated on axis: ");
                Serial.print(selectedMotor);
            }
                break;

            case 'T': //Test - Checks the connection between the MCU and the TMC429 module. Just some random register reading.    
            {
                Serial.print("TMC429 actual pos-X: ");
                long xsteppos = stepper_controller.getActualPosition(0);
                Serial.println(xsteppos);
                Serial.println(calculatePositionMM(xsteppos));
                //----
                Serial.print("TMC429 actual pos-Y: ");
                long ysteppos = stepper_controller.getActualPosition(1);
                Serial.println(ysteppos);
                Serial.println(calculatePositionMM(ysteppos));
            }
            case 'R': //Reset - Code jumps back to setup() and reinitializes everything. Use it with caution!
            {
                Serial.println("RESET WAS INITIATED");
                setup(); //Go back to the setup() function and reinitialize everything.
            }
            break;

            }
        }
    }
    else
    {
        Serial.read(); //Read and discard the incoming data
        //This is useful because if the user accidentally sends something via UART while in joystick or button mode
        //It won't get performed once the user switches to UART mode
    }
}

void sendNewSettings()
{
    //Check the status of the mode selector switch 
    if (updateSettings == true)
    {
        updateSettings = false; //set to false, so this function only performed once
        abortMovement = false; //Reset abort status after changing a mode - abort can be reset by switching mode or axis
        limitSwitchWasHit = false; //Reset the limit switch hit status flag

        if (joystickMode == true)
        {
            //Print a message and switch to velocity mode
            Serial.println("Joystick mode enabled");
            stepper_controller.setVelocityMode(0);
            stepper_controller.setVelocityMode(1);
            stepper_controller.setVelocityMode(2);
            //-----
            //Make the other two modes false/disabled
            buttonMode = false;
            UARTMode = false;
        }
        //-----

        if (buttonMode == true)
        {
            //Print a message and switch to velocity mode
            Serial.println("Button mode enabled");
            stepper_controller.setVelocityMode(0);
            stepper_controller.setVelocityMode(1);
            stepper_controller.setVelocityMode(2);
            //-----
            //Make the other two modes false/disabled
            joystickMode = false;
            UARTMode = false;
        }
        //-----

        if (UARTMode == true)
        {
            //Print a message and switch to soft (or ramp) mode
            Serial.println("UART mode enabled");

            //When switching to UART mode, the target should be set as the actual position (Section 8.1.1)
            long tempPos_x = stepper_controller.getActualPosition(0);
            long tempPos_y = stepper_controller.getActualPosition(1);
            long tempPos_z = stepper_controller.getActualPosition(2);

            stepper_controller.setTargetPosition(0, tempPos_x);
            stepper_controller.setTargetPosition(1, tempPos_y);
            stepper_controller.setTargetPosition(2, tempPos_z);

            stepper_controller.setSoftMode(0); 
            stepper_controller.setSoftMode(1);
            stepper_controller.setSoftMode(2);
            //-----
            //Make the other two modes false/disabled
            buttonMode = false;
            joystickMode = false;
        }
    }
    
}

void motorHoming(int motorNumber) //Motor numbers: x = 0, y = 1, z = 2.
{
        //First of all, make sure that the system is in soft mode!
        if (joystickMode == true || buttonMode == true)
        {
            stepper_controller.setSoftMode(motorNumber);
            //Change the motor to soft mode if it was in velocity mode
        }
        //----
        //Set the motor to a slower speed temporarily, so it won't crash during homing. Pay attention, this value depends on the mechanism!!!
        stepper_controller.setLimitsInHz(motorNumber, VELOCITY_MIN, MICROSTEPS_PER_REV, ACCELERATION_MAX);
        // 

        /* HOMING PROCEDURE
        * 1; Dummy write to X_LATCHED
        * 2; Send the motor towards the negative direction
        * 3; When reaching X2, the position is latched
        * 4; Set the DX_REF_TOLERANCE to allow movement within the x1-x2 range and move to a position < x1 if desired
        * 5; Initialize X_LATCHED again, and latch the position x1 by a motion towards the positive direction
        * 6; When x1 and x2 are determined, ref becomes (x1+x2)/2.
        * 7; Move to X_TARGET = xref and set X_TARGET := 0 and X_ACTUAL := 0;
        */

        //stepper_controller.writeRegister(0, 0b1101, 1000);//x (0) motor, 1101 - DX_REF_TOLERANCE register, 1000 (?) steps. 
        //I am not sure if the above line is correct. 
        //---------------------------------------------------------------------------------------------------------------------------------

        // 1;
        //8.1.15: X_latched. This read-only register stores the actual position upon a change of the reference switch state. 
        stepper_controller.startLatchPositionWaiting(motorNumber); //Waits for the latch position (homing position where the switch were triggered)
        //Notice that if the motor is within x1-x2, it has to move out first because the switch is active.
        //We assume that the motor is not touching the switch right now

        //2;Motor is between xmax and x2 and latch is initialized. We need to go towards -1*xmax (negative direction).

        Serial.println("Homing started."); //Indicate that the homing motion is ongoing    
        stepper_controller.setTargetPosition(motorNumber, -5000000); //Send the motor backwards towards the left switch (REF1)
        //We need to send a ridiculuosly large target position so we can be sure that the motor will eventually reach the switch
        //When the motor is used with a lead screw, enter the equivalent number of steps for the length of the screw "plus a little"

        Serial.print("Latch status: "); //Check the latch status if it is correct
        Serial.println(stepper_controller.latchPositionWaiting(motorNumber)); //Print the latch status for the X (0) motor

        while (stepper_controller.latchPositionWaiting(motorNumber) == 1) //lp bit is set to 0 when the position is latched by the switch
        {
            //Wait here until the switch is latched
            //The motor is running in the meantime while the condition is true
        }//X2 reached after exiting the while()


        Serial.print("Latch status-x2: "); //Print the latch status for the X (0) motor after reaching the switch
        Serial.println(stepper_controller.latchPositionWaiting(motorNumber));

        long x2Pos = stepper_controller.getLatchPosition(motorNumber); //Save the current latch position for later calculations
        Serial.print("Latched-x2: "); Serial.println(x2Pos); //Print the latch position for the x2 position

        //Set a DX_REF_TOLERANCE to allow motion within x1-x2 range.
        stepper_controller.writeRegister(motorNumber, 0b1101, 20000);//x (0) motor, 1101 - DX_REF_TOLERANCE register, 10000 steps. 
        //I am not sure about the number of steps, this could be determined by experiment, but 10k seems fine
        Serial.println("DX tolerance done"); //Indicate the status

        //Initialize X_Latched again to latch the position x1 by a motion to a target position below x1 (between x1 and dx1)
        stepper_controller.startLatchPositionWaiting(motorNumber); //Re-initialize latching
        Serial.println("Latch reinitalized"); //Print status
        stepper_controller.setTargetPosition(motorNumber, (x2Pos + 6000)); //Send the motor backwards towards the left switch (REF1) by a little
        //The stepper goes towards an even more negative position, but short enough so that the switch status is still pressed
        //Again, the number of steps is experimental!

        //Next, we wait until the motor reaches the target position
        while (stepper_controller.atTargetPosition(motorNumber) == 0)
        {
            //Wait here until the target is reached
            //The motor is running in the meantime while the condition is true
        }

        Serial.print("Latch status-x1: "); //Print the latch status. It should be still ready to be latched (unchanged, == 1)
        Serial.println(stepper_controller.latchPositionWaiting(motorNumber));

        long x1Pos = stepper_controller.getLatchPosition(motorNumber); //Save the new latch position and print it
        Serial.print("Latched-x1: "); Serial.println(x1Pos);

        long refPos = (long)((x2Pos + x1Pos) / 2); //Calculate the midpoint between x2 and x1. This is the reference (home) position
        //Keep in mind that the motor here is still stopped and the limit switch is pressed.

        Serial.print("RefPos: "); Serial.println(refPos); //Print the reference position just for checking

        stepper_controller.setTargetPosition(motorNumber, refPos); //Update the target position as the reference position - move the motor to the midpoint

        Serial.println("Moving towards RefPos");
        while (stepper_controller.atTargetPosition(motorNumber) == 0)
        {
            //Wait here until we reach the target position (xref)            
        }
        Serial.println("Arrived at RefPos");

        stepper_controller.setVelocityMode(motorNumber);//Before overwriting X_ACTUAL choose velocity_mode or hold_mode.
        stepper_controller.setTargetVelocity(motorNumber, 0); //...the parameter V_MAX should be set to zero...
        stepper_controller.setActualPosition(motorNumber, 0); //set X (0) position to 0 at the reference position
        stepper_controller.setTargetPosition(motorNumber, 0); //Target has to be set to 0, so the latest value (-xmax) is updated.

        Serial.print("Home: "); Serial.println(stepper_controller.getActualPosition(motorNumber)); //Print the new home position (it should be 0)

        Serial.println("Homing completed"); //Print status message.

        //First of all, make sure that the system is in soft mode!
        if (joystickMode == true || buttonMode == true)
        {
            //Latest mode was velocity mode, so we leave it as-is
        }
        else
        {
            stepper_controller.setSoftMode(motorNumber); //Set back soft mode (mode was UART)
        }

        //Reset initial speed settings
        stepper_controller.setLimitsInHz(motorNumber, VELOCITY_MIN, VELOCITY_MAX, ACCELERATION_MAX);    
}

void monitorLimitSwitches()
{
    if (limitSwitchesEnabled == true)//Only monitor limit switches if the user enabled it!
    {
        //This function monitors the limit switches while the motor is driven towards its target
        //Notice! All switches must be connected for proper behaviour!
        bool R_limitSwitchStatus = false; //Right limit switch, away from motor/home (positive direction)
        bool L_limitSwitchStatus = false; //Left limit switch, towards motor/home (negative direction)
        int motorNumber = 0;

        //Loop for R
        for (motorNumber = 0; motorNumber < 3; motorNumber++)
        {
            R_limitSwitchStatus = stepper_controller.rightSwitchActive(motorNumber);
            L_limitSwitchStatus = stepper_controller.leftSwitchActive(motorNumber);
            //Serial.print(String(motorNumber) + " ");
            //Serial.println(limitSwitchStatus);

            if (R_limitSwitchStatus == true)
            {
                //If any of the switches were activated, we stop 
                //Assumption: no simultaneous motor motion!

                limitSwitchWasHit = true; //Set the status to true
                limitSwitchActive = true;
                Serial.println("Right limit switch " + String(motorNumber) + " was activated");

                updateStatusLED();//Indicate status with red LED


                long tempposition = stepper_controller.getActualPosition(motorNumber);
                //Motor is stopped by the controller here as long as the switch is pressed
                stepper_controller.setTargetPosition(motorNumber, tempposition);

                //Check if this will interfere with homing!!!

                //Switch to velocity mode, so the motor can be controlled by speed
                stepper_controller.setVelocityMode(motorNumber); //Select the motor that triggered the switch
                stepper_controller.setTargetVelocity(motorNumber, -500); //Send it backwards with an arbitrary speed

                while (stepper_controller.rightSwitchActive(motorNumber) == true) //while the switch is active
                {
                    //This while() runs while the switch is pressed
                }

                stepper_controller.setTargetVelocity(motorNumber, 0); //Stop the motor by setting its speed to 0

                //These two lines make sure that the motor is stopped and it does not try to go towards the previously set target
                tempposition = stepper_controller.getActualPosition(motorNumber);
                stepper_controller.setTargetPosition(motorNumber, tempposition);

                stepper_controller.setSoftMode(motorNumber); //Set the motor back to soft mode (position mode)

                break; //Exit the for loop so the loop can inspect the other switches as well
            }


            if (L_limitSwitchStatus == true)
            {
                //If any of the switches were activated, we stop 
                //Assumption: no simultaneous motor motion!
                limitSwitchWasHit = true; //Set the status to true
                limitSwitchActive = true;
                Serial.println("Left limit switch " + String(motorNumber) + " was activated");

                updateStatusLED();

                long tempposition = stepper_controller.getActualPosition(motorNumber);
                //Motor is stopped by the controller here as long as the switch is pressed
                stepper_controller.setTargetPosition(motorNumber, tempposition);

                //Check if this will interfere with homing!!!

                //Switch to velocity mode, so the motor can be controlled by speed
                stepper_controller.setVelocityMode(motorNumber); //Select the motor that triggered the switch
                stepper_controller.setTargetVelocity(motorNumber, 500); //Send it forwards with an arbitrary speed

                while (stepper_controller.leftSwitchActive(motorNumber) == true) //while the switch is active
                {
                    //This while() runs while the switch is pressed
                }

                stepper_controller.setTargetVelocity(motorNumber, 0); //Stop the motor by setting its speed to 0

                //These two lines make sure that the motor is stopped and it does not try to go towards the previously set target
                tempposition = stepper_controller.getActualPosition(motorNumber);
                stepper_controller.setTargetPosition(motorNumber, tempposition);

                stepper_controller.setSoftMode(motorNumber); //Set the motor back to soft mode (position mode)

                break; //Exit the for loop so the loop can inspect the other switches as well
            }
        }
    }

}


float calculatePositionMM(long stepperMotorSteps)
{
  //Take the position of the motor in number of steps and convert it into millimetres
  float positionMM = 0;

  positionMM = (float)((stepperMotorSteps / MICROSTEPS_PER_REV) * xthreadPitch);
  //ex: (3200/1600) * 2 mm = 2*2 mm = 4 mm

  //The function could be used globally if all thread pitches and microsteps_per_rev are the same
  //As of now, this assumption is valid

   return positionMM; //return the calculated position in millimetres
}

long calculatePositionSteps(float stepperMotorMM)
{
  //Take the motor position (typically a target) in mm and convert it into steps

  long positionSteps = 0;

  positionSteps = (long)((stepperMotorMM / xthreadPitch) * MICROSTEPS_PER_REV);
  //ex: (8 mm / 2 mm) * 1600 steps = 4 * 1600 steps / 6400 steps

  //The function could be used globally if all thread pitches and microsteps_per_rev are the same
  //As of now, this assumption is valid

  return positionSteps; //return the calculated position in steps
}

void checkButtons()
{
    if (buttonMode == true) //Only listen to these 2 buttons in button mode
    {
        if (digitalRead(forwardButton) == 0) //Forward button is pressed
        {
            goForward = true;
            stepperIsMoving = true;
        }
        else if(digitalRead(backwardButton) == 0) //Backward button is pressed
        {
            goBackward = true;
            stepperIsMoving = true;
        }
        else //Forward or backward button is released
        {
            goBackward = false;
            goForward = false;
            stepperIsMoving = false;
        }
    }

   //----
   //We always listen to the abort button!    
   if(digitalRead(abortButton) == 0) //Abort button is pressed, this should be a 2-state (clicking) button, not a pushbutton!
   {
       Serial.println("Abort button was pressed!");

       if (stepperIsMoving == true) //Only abort movement when there's any
       {
           Serial.println("---STOP---");
           abortMovement = true;
           stepperIsMoving = false;
       }
       else //Otherwise, an alternative function is assigned to the abort button which is homing
       {
            Serial.println("Homing via abort button");
            if (buttonModeXAxis == true) //Internal pullup makes it 1 (true) by default, so we look for false (GND = 0) 
            {
            Serial.println("Homing X");
            motorHoming(0); //Home X
            }
            if (buttonModeYAxis == true) //Internal pullup makes it 1 (true) by default, so we look for false (GND = 0) 
            {
            Serial.println("Homing Y");
            motorHoming(1); //Home Y
            }
            if (buttonModeZAxis == true) //Internal pullup makes it 1 (true) by default, so we look for false (GND = 0) 
            {
            Serial.println("Homing Z");
            motorHoming(2); //Home Z
            }
            Serial.println("Homing is completed for all three axes!");
       }
   }
   else //Abort button is released
   {
      abortMovement = false;
   }  
   
}

void driveMotorWithButtons()
{
    //--------------------------------------------------------------------------------------------------------------------
    //Driving the motor forwards
    //Abort function is not used here since the motors immediately stop when the button is released
    //--------------------------------------------------------------------------------------------------------------------
    if (buttonMode == true) //If button mode enabled
    {
        if (goForward == true && goBackward == false) //The button is pressed (non-zero speed for the active motor)
        {
            Serial.println("FWD");
            //Then we need to check which selector is active
            if (buttonModeXAxis == true) //Internal pullup makes it 1 (true) by default, so we look for false (GND = 0) 
            {
                stepper_controller.setTargetVelocity(0, 500); //X (0) motor at 500 steps/s speed
                //The user has to pick a speed here
            }
            //---
            if (buttonModeYAxis == true)
            {
                stepper_controller.setTargetVelocity(1, 500); //Y (1) motor at 500 steps/s speed
                //The user has to pick a speed here
            }

            if (buttonModeZAxis == true)
            {
                stepper_controller.setTargetVelocity(2, 500); //Z (2) motor at 500 steps/s speed
                //The user has to pick a speed here
            }

            //no else branch, because one of the three conditions is always true

        }
        else if(goBackward == true && goForward == false) //The button is pressed (non-zero speed for the active motor)
        {
            Serial.println("BWD");
            //Then we need to check which selector is active
            if (buttonModeXAxis == true) //Internal pullup makes it 1 (true) by default, so we look for false (GND = 0) 
            {
                stepper_controller.setTargetVelocity(0, -500); //X (0) motor at -500 steps/s speed
                //The user has to pick a speed here
            }
            if (buttonModeYAxis == true)
            {
                stepper_controller.setTargetVelocity(1, -500); //Y (1) motor at -500 steps/s speed
                //The user has to pick a speed here
            }

            if (buttonModeZAxis == true)
            {
                stepper_controller.setTargetVelocity(2, -500); //Z (2) motor at -500 steps/s speed
                //The user has to pick a speed here
            }

            //no else branch, because one of the three conditions is always true

        }
        else //button is released (zero speed for the active motor)
        {
            Serial.println("Button mode - no button pressed.");
            //Then we need to check which selector is active
            if (buttonModeXAxis == true) //Internal pullup makes it 1 (true) by default, so we look for false (GND = 0) 
            {
                stepper_controller.setTargetVelocity(0, 0); //X (0) motor at 0 steps/s speed                
            }
            //---
            if (buttonModeYAxis == true)
            {
                stepper_controller.setTargetVelocity(1, 0); //Y (1) motor at 0 steps/s speed
            }

            if (buttonModeZAxis == true)
            {
                stepper_controller.setTargetVelocity(2, 0); //Z (2) motor at 0 steps/s speed
            }
            //no else branch, because one of the three conditions is always true
        }
    }
}
