//3-axis stepper motor controller using the TMC429 ramp generator and three TMC2209 silent stepper motor drivers

/*
Logic:
BUTTON MODE
Select the button mode using the mode selector switch
Select the X, Y or Z axis using the axis selector switch
Use the backward or forward buttons to move the selected axis
The device won't listen to the other two modes
-----
JOYSTICK MODE
Select the joystick mode using the mode selector switch
Move the joystick to move the axes. Axes can move simultaneously
The device won't listen to the other two modes
-----
UART MODE
Select the uart mode using the mode selector switch
Send the corresponding command to the Teensy 4.0 microcontroller
The device won't listen to the other two modes
*/

#include <SPI.h>    //SPI Library
#include <TMC2209.h> //TMC2209 library - Stepper motor config
#include <TMC429.h> //TMC429 library - Ramp generator
#include <Wire.h> //i2C Library


//Instantiate the drivers for the 3 axes
TMC2209 X_driver; //X axis driver and its address set via the MS1, MS2 pins
const TMC2209::SerialAddress SERIAL_ADDRESS_0 = TMC2209::SERIAL_ADDRESS_0; //GND-GND
TMC2209 Y_driver; //Y axis driver and its address set via the MS1, MS2 pins
const TMC2209::SerialAddress SERIAL_ADDRESS_1 = TMC2209::SERIAL_ADDRESS_1; //VCC-GND 
TMC2209 Z_driver; //Z axis driver and its address set via the MS1, MS2 pins
const TMC2209::SerialAddress SERIAL_ADDRESS_2 = TMC2209::SERIAL_ADDRESS_2; //GND-VCC

// Instantiate stepper controller - TMC 429
TMC429 stepper_controller;


//SPI on Teensy 4.0 vs. TMC429
//CS   10 - CSN_C
//MOSI 11 - SDI_C
//MISO 12 - SDO_C
//SCK  13 - SCK_C

//i2c on Teensy 4.0
//SDA 18
//SCL 19

HardwareSerial & serial_stream = Serial1; //1st UART port
//Unlike Arduino, Teensy has different Serial (USB) and Serial1 (UART)
//Serial1 is a hardware serial (UART) port

const long SERIAL_BAUD_RATE = 115200; //Baud rate of the UART
//----
const int RX_PIN = 0; //Physical pins of the serial port
const int TX_PIN = 1;

const int RUN_CURRENT_PERCENT = 40; //Percentage current
const int MICROSTEPS_PER_STEP = 16; //Microstepping (16 is more than enough)
const int CHIP_SELECT_PIN = 10; //Chip select pin ??? Is it for the TMC429 ???
const int CLOCK_FREQUENCY_MHZ = 32; //32 MHz - external source, generated by the Teensy on pin 9. See later in the code.
const int STEPS_PER_REV = 200; //Depends on the stepper motor, but typically either 200 (1.8 deg/step) or 400 (0.9 deg/step)
const int MICROSTEPS_PER_REV = STEPS_PER_REV * MICROSTEPS_PER_STEP; //Total steps needed to complete a full turn
const int ACCELERATION_MAX = MICROSTEPS_PER_REV * 4; //Needs to be tested empirically because the mechanism (friction) can affect it
const long ZERO_POSITION = 0; //Shortcut for the zero position
const long VELOCITY_MAX = 4 * MICROSTEPS_PER_REV; //Similarly to the acceleration, this is also empirical!
const long VELOCITY_MIN = 50; //Velocity cannot be 0, see datasheet. Below 50 steps/s the motor shuts down.

//Thread pitches
float xthreadPitch = 2.0; //Pitch of the thread in [mm]. 1 turn of the screw results in '_threadPitch' amount of linear displacement
float ythreadPitch = 2.0;
float zthreadPitch = 2.0;

//Pins
const byte Analog_X_pin = A2; //x-axis readings - A2: 16
const byte Analog_Y_pin = A1; //y-axis readings - A1: 15
const byte Analog_Z_pin = A0; //r-axis readings - A0: 14

const byte forwardButton = 2; //Forward button - when pressed, it drives the selected axis in the positive direction
const byte backwardButton = 3; //Backward button - when pressed, it drives the selected axis in the negative direction
const byte abortButton = 4; //Aborts all movements
const byte redLEDpin = 5; //Red
const byte greenLEDpin = 6; //Green
const byte blueLEDpin = 7; //Blue
const byte clkPin = 9;//32 MHz CLK source for the TMC429 - Clock signal is generated by the Teensy. Set the CPU to 528 MHz!
//Limit switches are treated by the TMC429!

//Variables
int Analog_X = 0; //x-axis value
int Analog_Y = 0; //y-axis value
int Analog_Z = 0; //r-axis value

int Analog_X_AVG = 0; //x-axis value average
int Analog_Y_AVG = 0; //y-axis value average
int Analog_Z_AVG = 0; //r-axis value average

byte previousGPIOData = 0; //Previous data from GPIO - helps to detect new settings

long receivedAcceleration; //acceleration sent through USB
long receivedVelocity; //velocity sent through USB

bool goForward = false; //forward motion enabled/disabled
bool goBackward = false; //backward motion enabled/disabled
bool abortMovement = false; //Abort button was pressed
bool limitSwitchWasHit = false; //If any of the 6 limit switches were hit (not during homing)
bool buttonModeXAxis = false; //Active axis in button mode is X
bool buttonModeYAxis = false; //Active axis in button mode is Y
bool buttonModeZAxis = false; //Active axis in button mode is Z
bool joystickMode = false; //Joystick mode enabled (3-axis joystick)
bool buttonMode = false; //Button mode enabled (forward and backward button)
bool UARTMode = true; //UART mode enabled (serial port control)
bool updateSettings = false; //Allows the code to update the settings (typically sends new config to the TMC chips)
bool stepperIsMoving = false; //Flag to indicate if a stepper motor is moving
bool limitSwitchActive = false; //If any of the limit switches become active, this status becomes true
//--------------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------------
bool limitSwitchesEnabled = false; //Globally enable/disable limit switches for easier testing
//--------------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------------
bool debugMode = true;

int limitSwitchID = 0; //ID to see which switch got tripped
int modeSelection = 2; //0 = joystick, 1 = button, 2 = UART
int previousMode = 2; //Previous mode. Helps to keep track of change
unsigned long redLEDTimer = 0; //A variable that stores the elapsed time for the red LED
bool redLEDStatus = false; //Status flag of the red LED.


void setup()
{
  //SERIAL - USB
  Serial.begin(9600);
  Serial.println("TMC249 - TMC2209 - 3-axis motor driver board");

  //SERIAL - TMC2209
  Serial1.begin(SERIAL_BAUD_RATE);

  //Start the 32 MHz signal for the TMC429 (don't forget to compile the code with CPU = 528 MHz!)
  analogWriteFrequency(clkPin, CLOCK_FREQUENCY_MHZ*1000000); //Set pin and frequency
  analogWrite(clkPin, 128); //Start signal, 50% duty cycle

  //Motor drivers  
  X_driver.setup(Serial1, SERIAL_BAUD_RATE, SERIAL_ADDRESS_0);
  Y_driver.setup(Serial1, SERIAL_BAUD_RATE, SERIAL_ADDRESS_1);
  Z_driver.setup(Serial1, SERIAL_BAUD_RATE, SERIAL_ADDRESS_2);
  //----------------------------------------------------------------------------
  Wire.begin(); 
  Wire.beginTransmission(0x20);
  Wire.write(0xFF);  //All ON - This is needed to be used with pull-up resistors
  Wire.endTransmission();
  
  //----------------------------------------------------------------------------
  //PINS
  pinMode(forwardButton, INPUT);
  pinMode(backwardButton, INPUT);
  pinMode(abortButton, INPUT);
  pinMode(redLEDpin, OUTPUT);
  pinMode(greenLEDpin, OUTPUT);
  pinMode(blueLEDpin, OUTPUT);

  //No lights
  analogWrite(redLEDpin, 0);
  analogWrite(greenLEDpin, 0);
  analogWrite(blueLEDpin, 0);
  

  //----------------------------------------------------------------------------
  InitialValues(); //averaging the values of the 3 analog pins (values from potmeters)
  //----------------------------------------------------------------------------
  
  //Stepper parameters
  //setting up some default values for maximum speed and maximum acceleration
  X_driver.setRunCurrent(RUN_CURRENT_PERCENT);
  X_driver.enableAutomaticCurrentScaling();
  X_driver.enableAutomaticGradientAdaptation();
  X_driver.enableCoolStep();
  X_driver.setMicrostepsPerStep(MICROSTEPS_PER_STEP);
  X_driver.enableStealthChop(); //This MUST be enabled for correct motor behaviour
    
  stepper_controller.setup(CHIP_SELECT_PIN, CLOCK_FREQUENCY_MHZ);

  if (limitSwitchesEnabled == true)
  {
      stepper_controller.enableRightSwitches(); //Enable stop switches on the right side (far end)
  }  

  //The limit switch module I use is HIGH by default. When pressed, it goes LOW.

  //A reference switch can be used as an automatic stop switch.
  //The ref switch indicates the reference position within a given tolerance.
  //When a reference switch is triggered, the actual position can be stored automatically.
  //This allows a precise determination of the ref point.
  //The stepper motor stops if the reference/stop switch becomes active.

  //Right switch when the motor is moving to a more positive direction (CW, away from motor)
  //Left switch when the motor is moving to a more negative direction (CCW, towards motor)

  /*
         [LS]       <-||->          [RS]
    [MOT]-------------==----------------  
  */

  //disable_stop_l: 0 - the motor will be stopped when the velocity is negative (V_actial < 0) and the LREF becomes active
  //disable_stop_r: 0 - Stops the motor if the velocity is positive and the RREF switch becomes active
  //soft_stop: 0 - Stops imediately (hard stop), 1: soft stop - NEED TO TEST
  //ref_RnL: 0 - Left switch is the reference switch, 1: right switch is the reference.

  //Limit switch: Datasheet page 33.
  /*
  setSwitchesActiveHigh()
  setSwitchesActiveLow() //Choose one depending on the limit switch modules. All 6 modules must be the same!!!
  */

  if (limitSwitchesEnabled == true)
  {
      stepper_controller.setSwitchesActiveLow(); //When switch goes HIGH, it sets an active reference switch signal.
  }

  //Active LOW: Pin status is 3.3V (HIGH) by default and goes LOW when the switch is pressed
  //Active HIGH: Pin status is GND (LOW) by default and goes HIGH when the switch is pressed
  //The red limit switches I use for this board are active LOW.  
  //--------------------------------------------------------------------------------------------------------------

  if (limitSwitchesEnabled == true)
  {
      stepper_controller.enableLeftSwitchStop(0); //X (0) Motor stops when the speed is negative and REF1 is active
      stepper_controller.enableRightSwitchStop(0); //X (0) Motor stops when the speed is positive and REFR1 is active

      //stepper_controller.enableSwitchSoftStop(0); //X (0) Motor stops softly when hitting the switch - Pick one
      stepper_controller.disableSwitchSoftStop(0); //X (0) Motor stops hard when hitting the switch

      stepper_controller.setReferenceSwitchToLeft(0); //Homing switch is at the left (negative, motor) side  
  }
  

  //ALL 3 axes' reference (limit) switches have to be handled!
  stepper_controller.setLimitsInHz(0, VELOCITY_MIN, VELOCITY_MAX, ACCELERATION_MAX);
  stepper_controller.setVelocityMode(0);//Before overwriting X_ACTUAL choose velocity_mode or hold_mode.
  stepper_controller.setTargetVelocity(0, 0); //...the parameter V_MAX should be set to zero...
  stepper_controller.setActualPosition(0, ZERO_POSITION);
  stepper_controller.setTargetPosition(0, ZERO_POSITION);
  stepper_controller.setSoftMode(0); // Ramp with soft stop - X
  delay(500);
  //----------------------------------------------------------------------------
  Y_driver.setRunCurrent(RUN_CURRENT_PERCENT);
  Y_driver.enableAutomaticCurrentScaling();
  Y_driver.enableAutomaticGradientAdaptation();
  Y_driver.enableCoolStep();
  Y_driver.setMicrostepsPerStep(MICROSTEPS_PER_STEP);
  Y_driver.enableStealthChop(); //This MUST be enabled for correct motor behaviour

  if (limitSwitchesEnabled == true)
  {
      stepper_controller.enableLeftSwitchStop(1); //Y (1) Motor stops when the speed is negative and REF1 is active
      stepper_controller.enableRightSwitchStop(1); //Y (1) Motor stops when the speed is positive and REFR1 is active

      //stepper_controller.enableSwitchSoftStop(1); //Y (1) Motor stops softly when hitting the switch - Pick one
      stepper_controller.disableSwitchSoftStop(1); //Y (1) Motor stops hard when hitting the switch

      stepper_controller.setReferenceSwitchToLeft(1); //Homing switch is at the left (negative, motor) side
  }
  

  stepper_controller.setLimitsInHz(1, VELOCITY_MIN, VELOCITY_MAX, ACCELERATION_MAX);
  stepper_controller.setVelocityMode(1);//Before overwriting X_ACTUAL choose velocity_mode or hold_mode.
  stepper_controller.setTargetVelocity(1, 0); //...the parameter V_MAX should be set to zero...
  stepper_controller.setActualPosition(1, ZERO_POSITION);
  stepper_controller.setTargetPosition(1, ZERO_POSITION);
  stepper_controller.setSoftMode(1); // Ramp with soft stop - Y
  delay(500);
  //----------------------------------------------------------------------------
  Z_driver.setRunCurrent(RUN_CURRENT_PERCENT);
  Z_driver.enableAutomaticCurrentScaling();
  Z_driver.enableAutomaticGradientAdaptation();
  Z_driver.enableCoolStep();
  Z_driver.setMicrostepsPerStep(MICROSTEPS_PER_STEP);
  Z_driver.enableStealthChop(); //This MUST be enabled for correct motor behaviour

  if (limitSwitchesEnabled == true)
  {      
      stepper_controller.enableLeftSwitchStop(2); //Z (2) Motor stops when the speed is negative and REF1 is active
      stepper_controller.enableRightSwitchStop(2); //Z (2) Motor stops when the speed is positive and REFR1 is active

      //stepper_controller.enableSwitchSoftStop(2); //Z (2) Motor stops softly when hitting the switch - Pick one
      stepper_controller.disableSwitchSoftStop(2); //Z (2) Motor stops hard when hitting the switch

      stepper_controller.setReferenceSwitchToLeft(2); //Homing switch is at the left (negative, motor) side      
  }

  stepper_controller.setLimitsInHz(2, VELOCITY_MIN, VELOCITY_MAX, ACCELERATION_MAX);
  stepper_controller.setVelocityMode(2);//Before overwriting X_ACTUAL choose velocity_mode or hold_mode.
  stepper_controller.setTargetVelocity(2, 0); //...the parameter V_MAX should be set to zero...
  stepper_controller.setActualPosition(2, ZERO_POSITION);
  stepper_controller.setTargetPosition(2, ZERO_POSITION);
  stepper_controller.setSoftMode(2); // Ramp with soft stop - X

  delay(500);

  //Enable all drivers
  X_driver.enable();
  Y_driver.enable();
  Z_driver.enable();

  //Enable step-dir interface
  X_driver.moveUsingStepDirInterface();
  Y_driver.moveUsingStepDirInterface();
  Z_driver.moveUsingStepDirInterface();


  //---DEMO. This entire part can be removed, it just wiggles the 3 axes to indicate that the device is turned on
  //Drive the drivers directly via UART - It wiggles all three axes a bit just to see that they work
  X_driver.moveAtVelocity(-2000); //Drive in the negative direction
  Y_driver.moveAtVelocity(-2000);
  Z_driver.moveAtVelocity(-2000);

  delay(1000);

  X_driver.moveAtVelocity(2000); //Drive in the positive direction
  Y_driver.moveAtVelocity(2000);
  Z_driver.moveAtVelocity(2000);

  delay(1000);
  X_driver.moveAtVelocity(0); //Stop
  Y_driver.moveAtVelocity(0);
  Z_driver.moveAtVelocity(0);
  //---ENDOFDEMO


}

void loop()
{
  serialCommandReceiver(); //Polls the serial port for incoming instructions/commands
  ReadAnalog(); //Read the joystick
  checkButtons(); //Poll the buttons
  driveMotorWithButtons(); //Send commands to the motor when it is actual
  // 
  readGPIOExpander(); //Read which axis and which control mode is enabled
  sendNewSettings(); //When the user switches to another mode, this function takes care of it. 
  monitorLimitSwitches(); //Keeps monitoring the switches and parks the motors after a limit switch was hit while moving
  checkMotorMovement(); //Check if the motor is moving so we can keep the LEDs properly updated
  //----------------------------------------------------------------------------------------------------------------------
  //This function runs last so everything has the chance to update the statuses
  updateStatusLED();
}

void checkMotorMovement()
{
    for (int i = 0; i < 3; i++)
    {
        //Check each stepper motor if they are moving or not.
        if (stepper_controller.getActualVelocity(i) != 0)
        {
            stepperIsMoving = true;
            //If at least one motor is moving, we can immediately jump out of this loop
            break;
        } 
        else
        {
            stepperIsMoving = false;
        }
    }
}

void updateStatusLED()
{
    //This function follows the status flags and triggers the correspoding LED

    //Abort button is pressed - Blinking Red
    if (abortMovement == true)
    {
        //Serial.println("Red LED, blinking");
        if (millis() - redLEDTimer >= 1000) //Blink Red LED every 1 s
        {
            if (redLEDStatus == false)
            {
                analogWrite(redLEDpin, 255);
                analogWrite(greenLEDpin, 0);
                analogWrite(blueLEDpin, 0);
                redLEDStatus = true;
            }
            else
            {
                analogWrite(redLEDpin, 0); //(no need to update all three because the previous if() did it)
                redLEDStatus = false;
            }
            redLEDTimer = millis();
        }
    }
    
    else if (stepper_controller.communicating() == false)
    {       
        analogWrite(redLEDpin, 255);
        analogWrite(greenLEDpin, 165);
        analogWrite(blueLEDpin, 0);
    }    
    else if(limitSwitchActive == true) //Turn on red LED when any of the limit switches are active
    {
        analogWrite(redLEDpin, 255);
        analogWrite(greenLEDpin, 0);
        analogWrite(blueLEDpin, 0);
    }
    else if (stepperIsMoving == true) //Turn on green LED when any of the motors are moving
    {
        analogWrite(redLEDpin, 0);
        analogWrite(greenLEDpin, 255);
        analogWrite(blueLEDpin, 0);
    }
    else //Standby - Turn on blue LED
    {
        analogWrite(redLEDpin, 0);
        analogWrite(greenLEDpin, 0);  
        analogWrite(blueLEDpin, 255);
    }
}

void readGPIOExpander()
{
    //This function reads the GPIO expander

    //0-1-2 pins: X-Y-Z selector - Always only 1 axis is active
    //3-4-5 pins: Joystick, button, UART selector - Always only 1 mode is active

    byte gpioData = 0; //8-bit reading from the expander

    Wire.requestFrom(0x20, 1); //get 1 byte (8bit) from 0x20 address

    if (Wire.available()) 
    {
        gpioData = Wire.read();
    }
    
    /*
    //This little code prints back the bits that were set for the GPIO module
    Serial.print("GPIO: ");
    for (int i = 7; i >= 0; i--)
    {
        Serial.print((gpioData >> i) & 1); 
        //Print/shift the register bits until the whole byte is printed
    }
    Serial.println();    
    //------------------------------------------------------------------------------
    */
    

    if (previousGPIOData != gpioData)
    {
        previousGPIOData = gpioData; //Update to the most recent reading
        updateSettings = true; //Let the rest of the code know about the new values
        limitSwitchActive = false; //Reset limit switch status here
        Serial.println("Updated switch statuses!");

        //Blink the blue LED to indicate the received change
        analogWrite(redLEDpin, 0);
        analogWrite(blueLEDpin, 0);
        analogWrite(greenLEDpin, 0);

        for (int i = 0; i < 3; i++)
        {
            analogWrite(blueLEDpin, 0);
            delay(50);
            analogWrite(blueLEDpin, 255);
            delay(50);
        } //(100+100)*5 ms = 1000 ms delay
    }

    //Ugly implementation of reading the individual bits

    if (bitRead(gpioData, 0) == 1) //If pin 0 is high
    {
        buttonModeXAxis = false;
    }
    else //Pin 0 is low -> pulled to GND via the switch, so it is ACTIVE!
    {
        buttonModeXAxis = true;
    }

    if (bitRead(gpioData, 1) == 1) //If pin 1 is high
    {
        buttonModeYAxis = false;
    }
    else
    {
        buttonModeYAxis = true;
    }

    if (bitRead(gpioData, 2) == 1) //If pin 2 is high
    {
        buttonModeZAxis = false;
    }
    else
    {
        buttonModeZAxis = true;
    }
    //----------------------------------------------------------------
    if (bitRead(gpioData, 3) == 1) //If pin 3 is high
    {        
        joystickMode = false;
    }
    else
    {
        joystickMode = true;
    }

    if (bitRead(gpioData, 4) == 1) //If pin 4 is high
    {
        buttonMode = false;
    }
    else
    {
        buttonMode = true;
    }

    if (bitRead(gpioData, 5) == 1) //If pin 5 is high
    {
        UARTMode = false;
    }
    else
    {
        UARTMode = true;
    }
    //--------------------------------------------------------------------
}

void ReadAnalog()
{
    if (joystickMode == true) //Only listen to the joystick when the joystick mode is enabled!
    {
        //Reading the 3 potentiometers in the joystick: x, y and r.

        for (int i = 0; i < 10; i++) //Sum 10 readings
        {
            Analog_X += analogRead(Analog_X_pin);
            delayMicroseconds(10);
            Analog_Y += analogRead(Analog_Y_pin);
            delayMicroseconds(10);
            Analog_Z += analogRead(Analog_Z_pin);
            delayMicroseconds(10);
        } //300 us delay + 30x ADC conversion time which is just a few us total

        //Divide the sum of 10 readings by 10
        Analog_X /= 10.0;
        Analog_Y /= 10.0;
        Analog_Z /= 10.0;
                

        //if the value is 20 units away from the average (midpoint), we allow the update of the speed
        //This is a sort of a filter for the inaccuracy of the reading
        if (abs(Analog_X - Analog_X_AVG) > 20)
        {
            if (debugMode == true){
                Serial.println("joystick-X");
                }
            //speed = x
            stepper_controller.setTargetVelocity(0, (int)(12 * (Analog_X - Analog_X_AVG)));      
            //The 12 multiplier depends on the mechanism used with the motor. Test it with your system!
            stepperIsMoving = true;                        
        }
        else if (abs(Analog_Y - Analog_Y_AVG) > 20)
        {
            if (debugMode == true){
                Serial.println("joystick-Y");
            }

            // speed = y
            stepper_controller.setTargetVelocity(1, (int)(12 * (Analog_Y - Analog_Y_AVG)));
            //The 12 multiplier depends on the mechanism used with the motor. Test it with your system!
            stepperIsMoving = true;
        }
        else if (abs(Analog_Z - Analog_Z_AVG) > 30) //Z works well with these settings
        {
            if (debugMode == true){
                Serial.println("joystick-Z");
            }

            //speed = z
            stepper_controller.setTargetVelocity(2, (int)(5 * (Analog_Z - Analog_Z_AVG)));
            //The 5 multiplier depends on the mechanism used with the motor. Test it with your system!
           stepperIsMoving = true;
        }
        else
        {
            if (debugMode == true){
                Serial.println("joystick-standstill");
            }

            //speed = 0 for all motors
            stepper_controller.setTargetVelocity(0, 0); 
            stepper_controller.setTargetVelocity(1, 0);
            stepper_controller.setTargetVelocity(2, 0);
            stepperIsMoving = false;
        }      
        //Reset analog values - necessary, otherwise the sum will be messed up!
        Analog_X = 0;
        Analog_Y = 0;
        Analog_Z = 0;
    }
}

void InitialValues()
{
  //Set the temp values to zero before averaging
  float tempX = 0;
  float tempY = 0;
  float tempZ = 0;
  //----------------------------------------------------------------------------
  //read the analog 50x, then calculate an average.
  //they will be the reference values
  for (int i = 0; i < 50; i++)
  {
    tempX += analogRead(Analog_X_pin);
    delay(10); //allowing a little time between two readings
    tempY += analogRead(Analog_Y_pin);
    delay(10);
    tempZ += analogRead(Analog_Z_pin);
    delay(10);
  }
  //(30 ms + readout(?))*50 times approx 2 seconds
  //----------------------------------------------------------------------------
  Analog_X_AVG =(int)( tempX / 50.0);
  Analog_Y_AVG =(int)(tempY / 50.0);
  Analog_Z_AVG =(int)(tempZ / 50.0); //The float division is casted into int.
  //----------------------------------------------------------------------------
  if (debugMode == true){
    Serial.print("AVG_X: ");
    Serial.println(Analog_X_AVG);
    Serial.print("AVG_Y: ");
    Serial.println(Analog_Y_AVG);
    Serial.print("AVG_Z: ");
    Serial.println(Analog_Z_AVG);
    Serial.println("Calibration is finished!");
  }
}

void goRelative(long Steps, int motorNumber) //Moves the stage by xSteps STEP along the X axis relative to the current position
{
    long targetSteps = 0;
    //Get the current position of the X motor in STEPS
    long start_position = stepper_controller.getActualPosition(motorNumber);

    //Add relative movement steps to the current position to get the new target location
    targetSteps = start_position + Steps;

    //send the command to the TMC429
    stepper_controller.setTargetPosition(motorNumber, targetSteps); //Move X (0) to the recently determined target

    if (debugMode == True){
        Serial.print("Start position: "); Serial.println(start_position);
        Serial.print("Moving by: "); Serial.println(Steps);
    }
}

void goToX(float xPosition) //Brings the stage to a predetermined x position in mm
{
    long xtargetSteps = 0; //Target position in steps units

    //convert xPosition (mm) to steps

    xtargetSteps = (long)((xPosition / xthreadPitch) * (MICROSTEPS_PER_REV));
    //Example where target is 5 mm: ( 5 / 2 ) * (256 * 200) = 2.5 * 51200 steps. OK!

    //send the command to the TMC429
    stepper_controller.setTargetPosition(0, xtargetSteps); //Move X (0) to the recently determined target
}

void goToY(float yPosition) //Brings the stage to a predetermined y position in mm
{
    long ytargetSteps = 0; //Target position in steps units

    //convert yPosition (mm) to steps

    ytargetSteps = (long)((yPosition / ythreadPitch) * (MICROSTEPS_PER_REV));
    //Example where target is 5 mm: ( 5 / 2 ) * (256 * 200) = 2.5 * 51200 steps. OK!

    //send the command to the TMC429
    stepper_controller.setTargetPosition(1, ytargetSteps); //Move Y (1) to the recently determined target
}

void goToZ(float zPosition) //Brings the stage to a predetermined z position in mm
{
    long ztargetSteps = 0; //Target position in steps units
    //convert xPosition (mm) to steps

    ztargetSteps = (zPosition / zthreadPitch) * (MICROSTEPS_PER_REV);
    //Example where target is 5 mm: ( 5 / 2 ) * (256 * 200) = 2.5 * 51200 steps. OK!
    // 
    //send the command to the TMC429
    stepper_controller.setTargetPosition(2, ztargetSteps); //Move z (2) to the recently determined target
}

